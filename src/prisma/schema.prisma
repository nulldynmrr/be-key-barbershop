generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum TipeAkun {
  free
  premium
  vip
}

model User {
  id                     String         @id @default(uuid())
  nama                   String
  email                  String?        @unique
  password               String?
  role                   Role           @default(user)
  tipe_akun              TipeAkun       @default(free)
  sisa_credit            Int            @default(3)
  device_cookie          String?        @unique
  status_langganan       Boolean        @default(false)
  tgl_berakhir_langganan DateTime?
  otp                    String? 
  otpExpires             DateTime?
  is_banned              Boolean        @default(false)
  agreed_to_terms        Boolean        @default(false)
  agreed_at             DateTime?
  createdAt              DateTime       @default(now())
  transactions           Transaction[]
  ai_generations         AIGeneration[]
  system_api_logs        SystemApiLog[]
  feedbacks              Feedback[]

  active_package_id      String?
  active_package         SubscriptionPackage? @relation(fields: [active_package_id], references: [id])
  audit_logs             AuditLog[]
}

model AuditLog {
  id         String   @id @default(uuid())
  admin_id   String
  action     String
  target     String?
  details    Json?
  ip_address String?
  userAgent  String?
  created_at DateTime @default(now())

  admin User @relation(fields: [admin_id], references: [id])

  @@map("audit_logs")
}

model Transaction {
  id              String   @id @default(uuid())
  user_id         String
  jenis_transaksi String
  nominal         Int
  status          String
  tgl_transaksi   DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [id])
}

model AIGeneration {
  id                    String         @id @default(uuid())
  user_id               String
  image_hash            String?        @db.VarChar(64)
  feature_fingerprint   String?        @db.VarChar(64)
  url_foto_upload       String
  url_hasil_img         Json?
  hasil_analisis        Json
  harga_credit_terpakai Int
  tgl_generate          DateTime       @default(now())
  user                  User           @relation(fields: [user_id], references: [id])
  system_api_logs       SystemApiLog[]

  @@index([user_id, image_hash, feature_fingerprint])
}

model SystemApiLog {
  id             String   @id @default(uuid())
  model_name     String
  input_tokens   Int
  output_tokens  Int
  total_tokens   Int
  cost_usd       Decimal  @db.Decimal(10, 6)
  tgl_penggunaan DateTime @default(now())

  koin_charged      Int     @default(0)
  service_fee_koin  Int     @default(0)
  token_fee_koin    Int     @default(0)
  features_used     String? @db.Text

  user_id          String?
  ai_generation_id String?

  user          User?         @relation(fields: [user_id], references: [id])
  ai_generation AIGeneration? @relation(fields: [ai_generation_id], references: [id])
}

model Service {
  id           Int     @id @default(autoincrement())
  nama_layanan String
  harga        Int
  deskripsi    String?
  durasi       Int?
  image_url    String?
}

model Barber {
  id              Int     @id @default(autoincrement())
  nama_kapster    String
  url_foto_upload String?
  pengalaman      Int?
  spesialisasi    String?
}

model Gallery {
  id               Int    @id @default(autoincrement())
  url_foto_gallery String
  kategori         String
}

model AdminTokenPurchase {
  id            String   @id @default(uuid())
  nama_paket    String
  jumlah_token  Int?
  kos_total_idr Int
  nominal_usd   Decimal  @default(0) @db.Decimal(10, 2)
  tgl_pembelian DateTime @default(now())
}

model AiModel {
  id              String  @id @default(uuid())
  namaRouter      String
  baseUrl         String
  modelName       String
  apiKey          String
  typeAi          String  
  pricingUnit     String  @default("TOKEN") 
  hargaInput1M    Float   @default(0)
  hargaOutput1M   Float   @default(0)
  hargaPerImage   Float   @default(0)
  maxBudget       Float
  rpmLimit        Int
  avgTokensPerUse Int     @default(2000)
  isActive        Boolean @default(true)

  packagesAsLlm   SubscriptionPackage[] @relation("LlmModel")
  packagesAsImage SubscriptionPackage[] @relation("ImageModel")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id])
  subject   String
  message   String   @db.Text
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model SystemConfig {
  id               Int      @id @default(1)
  globalMultiplier Float    @default(1.35)
  baseRateUsdIdr   Float
  inflationBuffer  Float    @default(0.05)
  adminFeeFixed    Float    @default(4500.0)
  mdrPercentage    Float    @default(0.007)
  updatedAt        DateTime @updatedAt
}

enum PackageType {
  ONETIME
  SUBSCRIPTION
}

model CreditPackage {
  id           Int         @id @default(autoincrement())
  nama_paket   String
  deskripsi    String?     @db.Text
  tipe_paket   PackageType @default(ONETIME)
  jumlah_koin  Int         @default(0)
  durasi_hari  Int?
  harga_normal Int
  harga_diskon Int?
  diskon_mulai DateTime?
  diskon_akhir DateTime?
  is_active    Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model SubscriptionPackage {
  id         String @id @default(uuid())
  namaPaket  String
  jumlahKoin Int
  deskripsi  String

  featStandardScan       Boolean @default(true)
  featFaceHeatmap        Boolean @default(false)
  featSymmetry           Boolean @default(false)
  featAdvMapping         Boolean @default(false)
  featHairAnalysis       Boolean @default(false)
  featRiskAnalysis       Boolean @default(false)
  featBarberInstructions Boolean @default(false)
  featVirtualTryOn       Boolean @default(false)
  virtualTryOnLimit      Int     @default(1)
  featHistory            Boolean @default(false)
  featTrendAnalysis      Boolean @default(false)

  llmModelId    String?
  imageModelId  String?
  llmModel      AiModel? @relation("LlmModel",   fields: [llmModelId],   references: [id])
  imageModel    AiModel? @relation("ImageModel", fields: [imageModelId], references: [id])

  typeValue    String
  durationDays Int?

  hppIdeal     Float
  hppBreakdown Json?
  hargaNominal Float

  promoAktif  Boolean   @default(false)
  hargaDiskon Float?
  diskonMulai DateTime?
  diskonAkhir DateTime?

  status String @default("AKTIF")

  users User[]
}

model FeaturePricing {
  id          String   @id @default(uuid())
  featureCode String   @unique 
  namaFitur   String   
  koinCost    Int    
  isActive    Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Notification {
  id              String   @id @default(uuid())
  type            String   
  source          String   
  title           String   @db.VarChar(255)
  message         String   @db.Text
  is_read         Boolean  @default(false)
  action_required Boolean  @default(false)
  
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("notifications")
}

model SocialMedia {
  id        Int      @id @default(autoincrement())
  title     String
  link      String
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Waitlist {
  id         String   @id @default(uuid())
  userId     String?
  email      String?
  phone      String?
  pesan      String   @db.Text
  is_handled Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("waitlist")
}